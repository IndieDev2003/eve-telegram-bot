# ==========================================
# Eve Agent Configuration (.env)
# ==========================================

# ------------------------------------------
# 1. Cloudflare Workers AI Configuration
# ------------------------------------------
# Find your Account ID in the Cloudflare Dashboard URL: https://dash.cloudflare.com/<ACCOUNT_ID>
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Create an API Token in Cloudflare Dashboard -> My Profile -> API Tokens -> Create Token -> "Workers AI Read / Edit"
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Model to use from Cloudflare Workers AI catalog (defaults to @cf/meta/llama-3.3-70b-instruct)
# Other options:
# - @cf/meta/llama-3.1-70b-instruct
# - @cf/meta/llama-3.1-8b-instruct
# - @cf/deepseek-ai/deepseek-r1-distill-qwen-32b
# - @cf/mistral/mistral-7b-instruct-v0.2
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct

# Optional: If you use Cloudflare AI Gateway, set the Gateway ID or full gateway URL
CLOUDFLARE_GATEWAY_ID=my-gateway
# CLOUDFLARE_AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/ACCOUNT_ID/GATEWAY_ID/workers-ai/v1

# ------------------------------------------
# 2. Telegram Bot Configuration
# ------------------------------------------
# Obtain your Bot Token by messaging @BotFather on Telegram (/newbot)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Set a random secret string to secure inbound webhooks from Telegram (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET_TOKEN=a_random_secure_secret_token_12345

# Optional: Your bot username (without @) to enable @mentions in group chats
TELEGRAM_BOT_USERNAME=your_bot_username

# ------------------------------------------
# 3. Gmail Configuration
# ------------------------------------------
# Your Gmail address
GMAIL_USER=your_email@gmail.com

# Display name for emails sent by Eve
GMAIL_SENDER_NAME=Eve Assistant

# OPTION A (Recommended): Gmail App Password
# Steps to generate:
# 1. Go to Google Account Settings: https://myaccount.google.com/security
# 2. Ensure 2-Step Verification is turned ON.
# 3. Search for "App Passwords" or navigate to: https://myaccount.google.com/apppasswords
# 4. Create a new App Password named "Eve Agent"
# 5. Paste the 16-character code below (spaces are automatically stripped):
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# OPTION B: Gmail OAuth2 (alternative to App Password)
# GMAIL_CLIENT_ID=your_client_id.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=your_client_secret
# GMAIL_REFRESH_TOKEN=your_refresh_token

# ------------------------------------------
# 4. Optional Agent Settings
# ------------------------------------------
# Human-in-the-loop (HITL) approval:
# Set to "true" to have Telegram show an interactive [Approve] / [Deny] inline button before sending emails.
# Set to "false" to send emails directly without confirmation.
REQUIRE_EMAIL_CONFIRMATION=false

# Port for the Eve HTTP/webhook server (default is 3000)
PORT=3000
